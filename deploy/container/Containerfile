      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=appbackup /usr/local/bin/appbackup /usr/local/bin/appbackup
COPY --from=appbackup /usr/local/bin/restic /usr/local/bin/restic
USER 65532:65532
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/appbackup"]
CMD ["help"]

