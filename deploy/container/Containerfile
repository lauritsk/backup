# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# Docker Hardened Images are pinned to their multi-platform indexes.
FROM dhi.io/golang:1.27-dev@sha256:ce4e3984089cc0429a487c42427c6c43331b5b4eac6a58d517afc2e7cb53dc08 AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILD_TIME=unknown
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w \
      -X github.com/lauritsk/backup/internal/buildinfo.Version=${VERSION} \
      -X github.com/lauritsk/backup/internal/buildinfo.Revision=${REVISION} \
      -X github.com/lauritsk/backup/internal/buildinfo.BuildTime=${BUILD_TIME}" \
      -o /out/ ./cmd/...

FROM dhi.io/golang:1.27-dev@sha256:ce4e3984089cc0429a487c42427c6c43331b5b4eac6a58d517afc2e7cb53dc08 AS restic-tool
ARG TARGETOS
ARG TARGETARCH
ARG RESTIC_VERSION=v0.19.1
ENV GOTOOLCHAIN=local
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} GOBIN=/out \
    go install -trimpath -ldflags="-s -w" github.com/restic/restic/cmd/restic@${RESTIC_VERSION}

FROM dhi.io/golang:1.27-dev@sha256:ce4e3984089cc0429a487c42427c6c43331b5b4eac6a58d517afc2e7cb53dc08 AS rclone-tool
ARG TARGETOS
ARG TARGETARCH
ARG RCLONE_VERSION=v1.75.0
ENV GOTOOLCHAIN=local
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} GOBIN=/out \
    go install -trimpath -ldflags="-s -w -X github.com/rclone/rclone/fs.VersionSuffix=" github.com/rclone/rclone@${RCLONE_VERSION}

FROM dhi.io/debian-base:bookworm@sha256:b436efa0c3f3f5ff6b49d14fc44ab677fc27ac37136dc4c558d8df66f6032035 AS pimbackup
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="pimbackup" \
      org.opencontainers.image.source="https://github.com/lauritsk/backup" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /out/pimbackup /usr/local/bin/pimbackup
USER 65532:65532
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/pimbackup"]
CMD ["help"]

FROM dhi.io/debian-base:bookworm@sha256:b436efa0c3f3f5ff6b49d14fc44ab677fc27ac37136dc4c558d8df66f6032035 AS appbackup
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="appbackup" \
      org.opencontainers.image.source="https://github.com/lauritsk/backup" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /out/appbackup /usr/local/bin/appbackup
COPY --from=restic-tool /out/restic /usr/local/bin/restic
USER 65532:65532
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/appbackup"]
CMD ["help"]

# Keep cloud credentials out of App Backup by running this target first.
FROM dhi.io/debian-base:bookworm@sha256:b436efa0c3f3f5ff6b49d14fc44ab677fc27ac37136dc4c558d8df66f6032035 AS rclone
ARG RCLONE_VERSION=v1.75.0
LABEL org.opencontainers.image.title="backup-rclone" \
      org.opencontainers.image.source="https://github.com/lauritsk/backup" \
      org.opencontainers.image.version="${RCLONE_VERSION}" \
      org.opencontainers.image.licenses="MIT"
COPY --from=rclone-tool /out/rclone /usr/local/bin/rclone
USER 65532:65532
WORKDIR /mirror
ENTRYPOINT ["/usr/local/bin/rclone"]
CMD ["version"]

# Native database client variants. SQLite support is built into every target.
