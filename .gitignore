# Deny by default. Add new repository paths explicitly.
*

# Repository metadata and automation
!/.gitignore
!/.containerignore
!/.goreleaser.yaml
!/.github/
!/.github/**/
!/.github/**/*.md
!/.github/**/*.yml
!/.github/**/*.yaml

# Go source
!/go.mod
!/go.sum
!/cmd/
!/cmd/**/
!/cmd/**/*.go
!/internal/
!/internal/**/
!/internal/**/*.go

# Documentation, licensing, and project tools
!/LICENSE
!/README.md
!/SPEC.md
!/cog.toml
!/hk.pkl
!/mise.toml
!/mise.lock

# Sanitized examples
!/configs/
!/configs/appbackup.example.json
!/configs/cloud-mirror.appbackup.example.json
!/configs/pimbackup.example.json

# Deployment definitions
!/deploy/
!/deploy/**/
!/deploy/**/*.md
!/deploy/**/*.service
!/deploy/**/*.timer
!/deploy/**/*.conf
!/deploy/**/*.json
!/deploy/**/*.yaml
!/deploy/**/Containerfile
!/deploy/**/Containerfile.dockerignore
