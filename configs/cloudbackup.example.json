{
  "data_dir": "/data",
  "rclone": {
    "binary": "rclone",
    "config_path": "/etc/rclone/rclone.conf"
  },
  "server": {
    "listen": "127.0.0.1:8080",
    "read_header_timeout": "5s",
    "read_timeout": "30s",
    "idle_timeout": "60s",
    "shutdown_timeout": "15s"
  },
  "schedule": {
    "enabled": true,
    "interval": "24h",
    "run_on_start": false
  },
  "log": {
    "level": "info",
    "format": "json"
  },
  "sources": [
    {
      "id": "documents",
      "remote": "storage:Documents",
      "exclude": ["*.tmp", ".cache/**"],
      "bandwidth_limit": "20M",
      "transfers": 4,
      "checkers": 8,
      "timeout": "2h"
    }
  ]
}
